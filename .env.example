APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Map / Leaflet UI defaults. These are UI-only defaults, not authoritative
# kitchen data. Adjust the tile provider to any OpenStreetMap-compatible
# service. Attribution must remain accurate to the tile source.
MAP_DEFAULT_LATITUDE=-6.9175
MAP_DEFAULT_LONGITUDE=106.9270
MAP_DEFAULT_ZOOM=13
MAP_SELECTION_ZOOM=16
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_ATTRIBUTION="&copy; OpenStreetMap contributors"
MAP_TILE_MAX_ZOOM=19

# Delivery order configuration. These are non-secret domain rules and receipt
# formatting knobs. The concurrency limit is a domain rule, not a database
# constraint (AR-27). The receipt alphabet intentionally excludes visually
# ambiguous glyphs (0, O, 1, I, L).
DELIVERY_MAX_CONCURRENT_ACTIVE=1
DELIVERY_MAX_CONCURRENT_PER_COURIER=1
DELIVERY_RECEIPT_PREFIX=DEL
DELIVERY_RECEIPT_RANDOM_LENGTH=4
DELIVERY_RECEIPT_RANDOM_ALPHABET=ABCDEFGHJKMNPQRSTUVWXYZ23456789
DELIVERY_RECEIPT_DATE_TIMEZONE=Asia/Jakarta

# Delivery pricing configuration (AR-04, AR-29 revised, AR-32). All values
# are whole rupiah. Fee = max(minimum_fee, round(distance_km * rate, step)).
# The Haversine Earth-radius constant is not configurable; see
# App\Domain\Delivery\DistanceCalculator.
PRICING_MINIMUM_FEE_RUPIAH=5000
PRICING_RATE_PER_KM_RUPIAH=2000
PRICING_FEE_ROUNDING_STEP_RUPIAH=100

# Telemetry ingestion configuration (Packet 11).
#
#   TELEMETRY_RETENTION_DAYS
#     - AR-48. Days a `telemetry_records` row is retained past `received_at`.
#       A dedicated purge worker is deferred to a later packet; the schema
#       and configuration accommodate it without change.
#
#   TELEMETRY_MAX_SUBMISSIONS_PER_MINUTE
#     - AR-49. Per-device submission cap enforced by the named Laravel
#       rate limiter `telemetry` (keyed on `device:{id}`, not IP).
#
#   TELEMETRY_TOKEN_LENGTH / TELEMETRY_TOKEN_ALPHABET
#     - AR-47 revised. Bearer-token generation parameters. Tokens are
#       stored plaintext in `devices.api_token` and compared with
#       `hash_equals`. The 40/A-Za-z0-9 defaults yield ~238 bits of entropy.
TELEMETRY_RETENTION_DAYS=30
TELEMETRY_MAX_SUBMISSIONS_PER_MINUTE=60
TELEMETRY_TOKEN_LENGTH=40
TELEMETRY_TOKEN_ALPHABET=ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789

# Live-map polling and simulator configuration (Packet 12, AR-54 / AR-55 / AR-57).
#
#   TELEMETRY_POLLING_INTERVAL_MS
#     - AR-55. Default polling interval for the browser live-map, in
#       milliseconds. Emitted as `data-interval` on the map container.
#
#   TELEMETRY_POLLING_MAX_PER_MINUTE
#     - AR-57. Throttle cap applied to both live-map JSON endpoints.
#
#   TELEMETRY_SIMULATOR_BASE_URL
#     - AR-54. Origin used by `php artisan telemetry:simulate` when POSTing
#       to `/api/telemetry`. The simulator exercises the real ingestion
#       pipeline, not the database directly.
#
#   TELEMETRY_SIMULATOR_INTERVAL / TELEMETRY_SIMULATOR_DURATION /
#   TELEMETRY_SIMULATOR_JITTER
#     - Defaults for the matching command-line options.
TELEMETRY_POLLING_INTERVAL_MS=3000
TELEMETRY_POLLING_MAX_PER_MINUTE=60
TELEMETRY_SIMULATOR_BASE_URL=http://127.0.0.1:8000
TELEMETRY_SIMULATOR_INTERVAL=2
TELEMETRY_SIMULATOR_DURATION=120
TELEMETRY_SIMULATOR_JITTER=0.0
